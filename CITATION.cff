    # Gebze Technical University: ROR https://ror.org/01sdnnq10
    affiliation: "Gebze Technical University, Department of Mathematics"
    email: "oguzhanselcuk@gtu.edu.tr"
# Must equal jacopy.__version__ (jacopy/__init__.py); pinned by
# tests/test_citation_metadata.py.
version: "0.1.0"
license: BSD-3-Clause
repository-code: "https://github.com/oselcukk/JacoPy"
url: "https://oselcukk.github.io/JacoPy/"
keywords:
  - graded algebra
  - lie algebroid
  - courant algebroid
  - generalized geometry
  - metric-affine geometry
  - poisson geometry
  - cartan calculus
  - symbolic computation
