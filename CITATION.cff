version: "0.1.0a1"
license: BSD-3-Clause
repository-code: "https://github.com/oselcukk/JacoPy"
url: "https://oselcukk.github.io/JacoPy/"
keywords:
  - graded algebra
  - lie algebroid
  - courant algebroid
  - generalized geometry
  - metric-affine geometry
  - poisson geometry
  - cartan calculus
  - symbolic computation
